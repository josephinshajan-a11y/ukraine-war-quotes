ANTHROPIC_API_KEY=

# Models. Extraction runs once per article; the digest runs once a day.
QUOTEBASE_EXTRACT_MODEL=claude-sonnet-5-5
QUOTEBASE_DIGEST_MODEL=claude-opus-5-5
# Leave empty for models that do not accept a temperature setting.
QUOTEBASE_TEMPERATURE=0

# Fetching
QUOTEBASE_HOST_DELAY=1.5
QUOTEBASE_RESPECT_ROBOTS=1
QUOTEBASE_ARCHIVE_FALLBACK=1
# Needs `pip install -e ".[browser]"` and `playwright install chromium`
QUOTEBASE_BROWSER_FALLBACK=0
QUOTEBASE_DAILY_LOOKBACK=3

# Paywalled sources: the Cookie header from a logged-in browser session
QUOTEBASE_COOKIES_FT=
QUOTEBASE_COOKIES_ECONOMIST=
QUOTEBASE_COOKIES_BLOOMBERG=
