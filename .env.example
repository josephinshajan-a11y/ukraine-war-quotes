# Model API. Defaults use Groq's free tier (key from console.groq.com).
QUOTEBASE_LLM_PROVIDER=openai
QUOTEBASE_LLM_BASE_URL=https://api.groq.com/openai/v1
QUOTEBASE_LLM_API_KEY=
# Comma-separated: the next model is used when one reaches its daily limit.
QUOTEBASE_EXTRACT_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
QUOTEBASE_DIGEST_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b
QUOTEBASE_REASONING_EFFORT=low

# Sized for free tiers with small per-minute token limits.
QUOTEBASE_LLM_MAX_TOKENS=3000
QUOTEBASE_CHUNK_CHARS=9000
QUOTEBASE_DIGEST_BATCH=30
QUOTEBASE_DIGEST_REF_SAME=10
QUOTEBASE_DIGEST_REF_OTHER=5
QUOTEBASE_DIGEST_SUMMARY_QUOTES=30
QUOTEBASE_LLM_MIN_INTERVAL=30
QUOTEBASE_TRIM_TO_TOPIC=1
QUOTEBASE_TEMPERATURE=0

# Shows the Actions tab in the dashboard. Leave unset on a public deployment.
QUOTEBASE_ADMIN=1

# Fetching
QUOTEBASE_HOST_DELAY=1.5
QUOTEBASE_RESPECT_ROBOTS=1
QUOTEBASE_ARCHIVE_FALLBACK=1
QUOTEBASE_READER_FALLBACK=1
QUOTEBASE_BROWSER_FALLBACK=0
QUOTEBASE_DAILY_LOOKBACK=3

# Other providers:
#   Gemini:    QUOTEBASE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama:    QUOTEBASE_LLM_BASE_URL=http://localhost:11434/v1
#   Anthropic: QUOTEBASE_LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY=...

# Paywalled sources: the Cookie header from a logged-in browser session
QUOTEBASE_COOKIES_FT=
QUOTEBASE_COOKIES_ECONOMIST=
QUOTEBASE_COOKIES_BLOOMBERG=
